rules_version = '2';
// PokeSurvivor Nexus Edition: solo la cuenta de Google de Darvin lee y escribe.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDarvin() {
      return request.auth != null
        && request.auth.token.email == 'arondon33@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if esDarvin();
    }
  }
}
